{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "geoking",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "server.py"
      ],
      "port": 8080
    },
    {
      "name": "geoking-demo",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "GEOKING_DEMO=fert_max:ss,jp",
        "python3",
        "server.py"
      ],
      "port": 8080
    },
    {
      "name": "geoking-check",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PORT=8090",
        "GEOKING_DEV=1",
        "python3",
        "server.py"
      ],
      "port": 8090
    },
    {
      "name": "survival",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PORT=8092",
        "GEOKING_DEV=1",
        "GEOKING_RULE=survival",
        "python3",
        "server.py"
      ],
      "port": 8092
    },
    {
      "name": "survival-normal",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PORT=8093",
        "GEOKING_DEV=1",
        "python3",
        "server.py"
      ],
      "port": 8093
    }
  ]
}